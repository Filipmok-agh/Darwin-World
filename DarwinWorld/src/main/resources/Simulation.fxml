<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            minHeight="900.0" minWidth="1900">
    <left>
        <VBox spacing="15" style="-fx-padding: 5px">
            <VBox>
                <Label text="General Statistics:" style="-fx-font-size: 30px;"/>
                <Label style="-fx-font-size: 15px;" fx:id="day" text="Current day: "/>
                <Label style="-fx-font-size: 15px;" fx:id="animalsCount" text="Total number of animals: "/>
                <Label style="-fx-font-size: 15px;" fx:id="grassCount" text="Total number of plants: "/>
                <Label style="-fx-font-size: 15px;" fx:id="freeFields" text="Number of free fields: "/>
                <Label style="-fx-font-size: 15px;" fx:id="mostPopularGen" text="Most popular genotype: "/>
                <Label style="-fx-font-size: 15px;" fx:id="avgAnimalEnergy" text="Average energy level: "/>
                <Label style="-fx-font-size: 15px;" fx:id="avgDaysAlive" text="Average days alive: "/>
                <Label style="-fx-font-size: 15px;" fx:id="avgChildCount" text="Average number of children: "/>
            </VBox>
            <VBox>
                <Label text="Animal Statistics:" style="-fx-font-size: 30px;"/>
                <Label style="-fx-font-size: 15px;" fx:id="obsGens" text="Genome: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsCurrGen" text="Current gene: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsEnergy" text="Energy amount: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsGrassCount" text="Number of plants eaten: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsChildCount" text="Number of children: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsDescendantsCount" text="Number of descendants: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsDaysAlive" text="Days Alive: "/>
                <Label style="-fx-font-size: 15px;" fx:id="obsFuneralDay" text="Funeral Day:  "/>
            </VBox>
            <VBox spacing="15" alignment="CENTER">
                <Button text="Show animals with most popular gene" fx:id="geneButton" style="-fx-padding: 5px; -fx-font-size: 15px;"/>
                <Button text="Switch jungle tiles visibility" fx:id="greenButton" style="-fx-padding: 5px; -fx-font-size: 15px;"/>
            </VBox>
            <VBox alignment="CENTER">
                <Button text="Stop" fx:id="runButton" style="-fx-padding: 5px; -fx-font-size: 15px;"/>
            </VBox>
        </VBox>
    </left>
    <center>
        <GridPane fx:id="mapGrid" gridLinesVisible="true" alignment="CENTER"/>
    </center>
</BorderPane>